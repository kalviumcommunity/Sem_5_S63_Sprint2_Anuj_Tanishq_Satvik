# ==============================================================================
# ResearchMate - Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME=ResearchMate
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000"]

# Security
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration
# Supported providers: openai, gemini, anthropic, ollama, mock
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TOP_P=1.0
LLM_SEED=42
LLM_TIMEOUT_SECONDS=30.0
LLM_RESPONSE_FORMAT=text
LLM_MAX_RETRIES=2

# Embedding Configuration
# Supported providers: openai, sentence-transformers, ollama, mock
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32

# Vector Database Configuration
# Supported providers: memory, chroma, pgvector
VECTOR_DB_TYPE=memory
VECTOR_DB_PATH=./data/vector_db
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Document Ingestion & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_EXTENSIONS=[".pdf",".docx",".txt",".md"]
UPLOAD_DIRECTORY=./data/uploads

# Retrieval & Guardrails
TOP_K_RETRIEVAL=10
TOP_K_RERANKED=5
SIMILARITY_THRESHOLD=0.65
GROUNDING_THRESHOLD=0.60
REFUSAL_MESSAGE="I couldn't find enough supporting information in the available academic sources to answer this reliably."

# Context Window & History Management
MAX_HISTORY_TURNS=5
MAX_HISTORY_TOKENS=1500
MAX_CONTEXT_WINDOW_TOKENS=4000
